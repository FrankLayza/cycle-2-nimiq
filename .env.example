# ------------------------------------------------------------------
# Server (packages/server) — copy to .env and fill real values.
# NEVER commit real secrets. Dummy values here only.
# ------------------------------------------------------------------
PORT=8080
# SQLite database path. On Railway, mount a volume at /data.
DB_PATH=./data/snake.db
# Comma-separated list of allowed client origins (CORS). Dev defaults: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# Admin token for /api/v1/admin/* (payout jobs, stats). Long random string.
ADMIN_TOKEN=change-me-admin-token
# Reward signer private key (our seeded pool — never user funds). Testnet only in dev.
REWARD_SIGNER_KEY=
# Optional transaction fee in NIM; zero is valid on Nimiq unless the network is congested.
REWARD_FEE_NIM=0
# Set true only when this server is the designated fallback scheduler (Railway cron is preferred).
PAYOUT_SCHEDULER=false
# nimiq | testnet
NIM_NETWORK=testnet
# Salt used to derive the daily Today's Run seed. Keep secret + stable.
SEED_SALT=change-me-seed-salt
# Public app URL (used in share cards / docs).
APP_URL=http://localhost:5173

# ------------------------------------------------------------------
# Client (packages/client) — build-time env. Vite exposes VITE_* vars.
# Dev defaults proxy /api and /colyseus to the server (see vite.config.ts).
# ------------------------------------------------------------------
VITE_API_URL=/api/v1
VITE_WS_URL=/colyseus
VITE_NIMIQ_ENV=testnet
