{
  "name": "snake-rink",
  "private": true,
  "version": "0.1.0",
  "description": "Competitive Snake — Nimiq Mini App (Cycle II). Monorepo: packages/sim, packages/server, packages/client.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter @snake/server dev\" \"pnpm --filter @snake/client dev\"",
    "dev:server": "pnpm --filter @snake/server dev",
    "dev:client": "pnpm --filter @snake/client dev",
    "build": "pnpm --filter @snake/server build && pnpm --filter @snake/client build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
